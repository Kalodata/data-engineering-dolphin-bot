# CI/CD 用 — dolphin-bot ECS（GitHub Actions OIDC，无 AK/SK）
# 首次 Service 由运维创建；流水线：build/push → update-service --force-new-deployment

AWS_ACCOUNT_ID=136376784788
AWS_REGION=ap-southeast-1

# GitHub Actions 扮演的角色（OIDC）
CICD_ROLE_ARN=arn:aws:iam::136376784788:role/dolphin-bot-cicd

ECR_REPO=dolphin-bot
ECR_URI=136376784788.dkr.ecr.ap-southeast-1.amazonaws.com/dolphin-bot
# Tag: latest + <git-sha>

ECS_CLUSTER=dolphin-bot
ECS_SERVICE=dolphin-bot
ECS_TASK_FAMILY=dolphin-bot
ECS_CONTAINER_NAME=dolphin-bot

# Fargate 1 vCPU / 2048 MiB, desired-count=1
ECS_CPU=1024
ECS_MEMORY=2048
ECS_DESIRED_COUNT=1

EXECUTION_ROLE_ARN=arn:aws:iam::136376784788:role/dolphin-bot-ecs-execution-role
TASK_ROLE_ARN=arn:aws:iam::136376784788:role/dolphin-bot-ecs-task-role

LOG_GROUP=/ecs/dolphin-bot

# OIDC 信任：默认仅 main。放宽任意分支：
#   sub = repo:Kalodata/data-engineering-dolphin-bot:*
