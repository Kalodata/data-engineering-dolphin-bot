{
  "allowed_users": ["ou_xxx"],
  "allowed_chats": [],
  "alert_chat_ids": [],
  "ds_project_code": "YOUR_DS_PROJECT_CODE",
  "ds_readonly": false,
  "sql_repo_path": "/path/to/your-pipeline-sql-repo",
  "enable_pr_lookup": true,
  "hive_probe": {
    "enabled": true,
    "on_alert": false,
    "on_diagnose": true,
    "jdbc_url": "jdbc:hive2://localhost:10001",
    "timeout_ms": 90000
  },
  "alert_watch": {
    "enabled": true,
    "interval_seconds": 90,
    "fallback_interval_seconds": 600,
    "lookback_minutes": 180,
    "max_pages": 8,
    "max_per_tick": 5,
    "heal_hold_minutes": 15,
    "fetch_log": true,
    "auto_register": true,
    "notify_chat_ids": [],
    "notify_user_ids": ["ou_xxx"],
    "dedupe_path": ".data/alert-dedupe.json"
  },
  "ds_alert_webhook": {
    "enabled": false,
    "prefer_push": true,
    "port": 18766,
    "bind": "127.0.0.1",
    "path": "/ds-alert",
    "token": ""
  },
  "feishu_card_callback": {
    "enabled": true,
    "port": 18767,
    "bind": "127.0.0.1",
    "path": "/feishu/card",
    "verification_token": "",
    "encrypt_key": ""
  },
  "projects": {
    "remote": "/path/to/dolphin-feishu-bot"
  },
  "agent_mcp_ds": true,
  "default_cloud_repo_key": "tiktok",
  "cloud_code_on_diagnose": false,
  "cloud_code_on_alert": false,
  "cloud_code_timeout_ms": 120000,
  "cloud_repos": {
    "tiktok": {
      "url": "https://github.com/Kalodata/data-analysis-tiktok",
      "starting_ref": "main"
    },
    "amazon": {
      "url": "https://github.com/Kalodata/data-analysis-amazon",
      "starting_ref": "main"
    },
    "shopee": {
      "url": "https://github.com/Kalodata/data-analysis-shopee",
      "starting_ref": "main"
    }
  },
  "model": "auto",
  "max_reply_chars": 6000,
  "alert_prompt_path": "/Users/you/.cursor/agents/alert/PROMPT.md",
  "board_push": {
    "enabled": false,
    "chat_id": "oc_xxx",
    "hours": [9, 11, 15, 19]
  }
}
